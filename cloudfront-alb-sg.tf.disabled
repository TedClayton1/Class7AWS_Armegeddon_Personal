resource "aws_security_group" "bos_cloudfront_to_alb_sg01" {
  name        = "bos-cloudfront-to-alb-sg01"
  description = "Allow CloudFront to reach ALB"
  vpc_id      = aws_vpc.bos_vpc01.id

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_vpc_security_group_ingress_rule" "bos_cf_to_alb_http" {
  security_group_id = aws_security_group.bos_cloudfront_to_alb_sg01.id
  from_port         = 80
  to_port           = 80
  ip_protocol       = "tcp"
  prefix_list_id    = "pl-3b927c52"
  description       = "Allow HTTP from CloudFront"
}

resource "aws_vpc_security_group_ingress_rule" "bos_cf_to_alb_https" {
  security_group_id = aws_security_group.bos_cloudfront_to_alb_sg01.id
  from_port         = 443
  to_port           = 443
  ip_protocol       = "tcp"
  prefix_list_id    = "pl-3b927c52"
  description       = "Allow HTTPS from CloudFront"
}
